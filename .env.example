DATABASE_URL="postgresql://beeze:beeze@localhost:5432/beeze?schema=public"

# Platform brand shown as "Powered by …" (default "Name TBD")
PLATFORM_NAME=""
# The platform's own domain in production, e.g. "nametbd.com". Leave empty locally.
PLATFORM_DOMAIN=""
# Local only: which business plain http://localhost:3000 opens when there are several
DEV_BUSINESS_SLUG=""

# Uploaded files (artwork, proofs). Local folder for now; swap for S3/R2 later.
STORAGE_DIR="./storage"

# Email. With no provider key, emails are recorded on the order but not sent.
EMAIL_FROM=""            # e.g. "orders@nametbd.com" (a verified sender domain)
RESEND_API_KEY=""        # use one of these two
POSTMARK_SERVER_TOKEN=""

# Development logins created by `npm run db:seed` (passwords min 10 chars)
SEED_PLATFORM_ADMIN_EMAIL=""
SEED_PLATFORM_ADMIN_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
