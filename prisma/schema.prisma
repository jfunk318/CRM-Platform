// Name TBD — database schema.
//
// Multi-business: every business (print shop) running on the platform owns
// its data. Every business table has `businessId`, and every link between
// two business tables includes it (composite foreign keys onto
// @@unique([businessId, id])), so the database itself refuses to connect one
// business's records to another's. The app adds a second layer: a database
// client scoped to the signed-in business (src/lib/db.ts).
//
// Import readiness: records that could come from an outside system carry
// `externalSource` + `externalId`, unique per business, so importers can
// upsert instead of duplicating.
//
// Links that used to be "set null on delete" use NoAction: Postgres would
// otherwise null businessId too. The app clears those links before deleting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform ───────────────────────────────────────────────────────────────

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum PriceRounding {
  CENT // round to nearest cent
  UP_TO_99 // round unit prices up to the next .99
}

// A business running on the platform (e.g. Company Name).
model Business {
  id                     String         @id @default(cuid())
  // Platform address: <slug>.<PLATFORM_DOMAIN>
  slug                   String         @unique
  name                   String
  // The business's own domain (e.g. companyname.com); its affiliate stores
  // live at <store>.<customDomain>.
  customDomain           String?        @unique
  status                 BusinessStatus @default(ACTIVE)
  currency               String         @default("USD")
  priceRounding          PriceRounding  @default(CENT)
  rushFeePct             Decimal        @default(0) @db.Decimal(6, 4)
  // Make a follow-up task when a sent quote has had no answer for this many days (empty = off).
  quoteFollowUpDays      Int?           @default(5)
  paymentSurchargePct    Decimal        @default(0) @db.Decimal(6, 4)
  // Shown on quotes, proofs, invoices and customer emails.
  email                  String? // replies from customers go here
  phone                  String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  region                 String?
  postalCode             String?
  country                String         @default("US")
  invoiceTerms           String? // e.g. "Payment due on receipt"
  paymentInstructions    String? // how to pay offline (checks payable to…)
  defaultDepositPct      Decimal        @default(0) @db.Decimal(6, 4) // of order total
  // Storefront defaults every store inherits unless it sets its own.
  defaultAccountMode     AccountMode    @default(OPTIONAL)
  defaultShowPrices      Boolean        @default(true)
  defaultAllowPayLater   Boolean        @default(false) // place orders without paying online (invoiced later)
  // Online payments through the business's own Stripe account. Secrets are
  // stored encrypted (APP_SECRET).
  stripeSecretKeyEnc     String?
  stripeWebhookSecretEnc String?
  // Slack incoming webhook for store owners' requests (encrypted).
  slackWebhookEnc        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  staff                  StaffUser[]
  suppliers              Supplier[]
  categories             Category[]
  productTypes           ProductType[]
  products               Product[]
  productCategories      ProductCategory[]
  productColors          ProductColor[]
  productSizes           ProductSize[]
  productVariants        ProductVariant[]
  productViews           ProductView[]
  viewImages             ViewImage[]
  decorationAreas        DecorationArea[]
  decorationMethods      DecorationMethod[]
  productTypeDecorations ProductTypeDecoration[]
  productDecorationRules ProductDecorationRule[]
  decorationPriceTables  DecorationPriceTable[]
  decorationPriceCells   DecorationPriceCell[]
  pricingGroups          PricingGroup[]
  markupTiers            MarkupTier[]
  quantityDiscounts      QuantityDiscount[]
  quantityDiscountTiers  QuantityDiscountTier[]
  taxRates               TaxRate[]
  companies              Company[]
  customers              Customer[]
  addresses              Address[]
  designs                Design[]
  designDecorations      DesignDecoration[]
  orderStatuses          OrderStatus[]
  orders                 Order[]
  orderLines             OrderLine[]
  orderLineSizes         OrderLineSize[]
  lineNames              OrderLineName[]
  orderEvents            OrderEvent[]
  counters               Counter[]
  storedFiles            StoredFile[]
  artworkAssets          ArtworkAsset[]
  orderFiles             OrderFile[]
  proofs                 Proof[]
  proofFiles             ProofFile[]
  payments               Payment[]
  emailMessages          EmailMessage[]
  workflowSteps          WorkflowStep[]
  productionJobs         ProductionJob[]
  productionJobSteps     ProductionJobStep[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderLines     PurchaseOrderLine[]
  blankAllocations       BlankAllocation[]
  stockMovements         StockMovement[]
  deliveryMethods        DeliveryMethod[]
  shipments              Shipment[]
  shipmentItems          ShipmentItem[]
  stores                 Store[]
  storeGroups            StoreGroup[]
  promoCodeStores        PromoCodeStore[]
  giftCodeStores         GiftCodeStore[]
  catalogImports         CatalogImport[]
  storeDeliveryMethods   StoreDeliveryMethod[]
  storePages             StorePage[]
  storeItems             StoreItem[]
  storeItemPrices        StoreItemPrice[]
  storeBatches           StoreBatch[]
  commissionPayouts      CommissionPayout[]
  carts                  Cart[]
  cartItems              CartItem[]
  promoCodes             PromoCode[]
  giftCodes              GiftCode[]
  giftCodeUses           GiftCodeUse[]
  customerSessions       CustomerSession[]
  customerTokens         CustomerToken[]
  storeContacts          StoreContact[]
  storeRequests          StoreRequest[]
  storeVisitDays         StoreVisitDay[]
  leads                  Lead[]
  leadEvents             LeadEvent[]
  tasks                  Task[]
  automationRules        AutomationRule[]
  automationEvents       AutomationEvent[]
  automationRuns         AutomationRun[]
}

// People who run the platform itself (not staff of a business).
model PlatformUser {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  active       Boolean           @default(true)
  sessions     PlatformSession[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model PlatformSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([userId])
}

// ─── Staff ──────────────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  SALES
  ARTWORK
  ARTWORK_MANAGER
  PRODUCTION
  PURCHASING
  SHIPPING
  REFUNDS
  STORE_MANAGER // affiliate stores area
}

model StaffUser {
  id                String              @id @default(cuid())
  businessId        String
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email             String
  name              String
  passwordHash      String?
  roles             StaffRole[]
  active            Boolean             @default(true)
  sessions          StaffSession[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assignedOrders    Order[]             @relation("OrderAssignee")
  createdOrders     Order[]             @relation("OrderCreator")
  orderEvents       OrderEvent[]
  uploadedFiles     StoredFile[]
  proofsCreated     Proof[]
  payments          Payment[]
  assignedJobs      ProductionJob[]     @relation("JobAssignee")
  managedStores     Store[]             @relation("StoreManager")
  catalogImports    CatalogImport[]
  jobStepsDone      ProductionJobStep[]
  purchaseOrders    PurchaseOrder[]
  stockMovements    StockMovement[]
  shipments         Shipment[]
  storeBatches      StoreBatch[]
  leadsOwned        Lead[]              @relation("LeadOwner")
  leadsCreated      Lead[]              @relation("LeadCreator")
  leadEvents        LeadEvent[]
  tasksAssigned     Task[]              @relation("TaskAssignee")
  tasksCreated      Task[]              @relation("TaskCreator")
  tasksDone         Task[]              @relation("TaskDoneBy")
  commissionPayouts CommissionPayout[]

  @@unique([businessId, id])
  @@unique([businessId, email])
}

// Sessions belong to a staff user, who belongs to one business.
model StaffSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the cookie token; the token itself is never stored
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Suppliers & catalog ────────────────────────────────────────────────────

enum SupplierIntegration {
  REST_API
  PROMOSTANDARDS
  CSV
  MANUAL
}

model Supplier {
  id             String              @id @default(cuid())
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code           String // "sanmar", "ss", "charles-river", "pennant"
  name           String
  integration    SupplierIntegration @default(MANUAL)
  active         Boolean             @default(true)
  // Where purchase orders are sent, and our account with the supplier.
  email          String?
  phone          String?
  accountNumber  String?
  notes          String?
  products       Product[]
  purchaseOrders PurchaseOrder[]
  catalogImports CatalogImport[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, code])
}

model Category {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String?
  sortOrder      Int               @default(0)
  parentId       String?
  parent         Category?         @relation("CategoryTree", fields: [businessId, parentId], references: [businessId, id], onDelete: NoAction)
  children       Category[]        @relation("CategoryTree")
  products       ProductCategory[]
  externalSource String?
  externalId     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, slug])
  @@unique([businessId, externalSource, externalId])
}

model ProductType {
  id                String                  @id @default(cuid())
  businessId        String
  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String // "Apparel", "Headwear", "Drinkware"
  allowProcessMix   Boolean                 @default(true)
  products          Product[]
  decorationMethods ProductTypeDecoration[]

  @@unique([businessId, id])
  @@unique([businessId, name])
}

enum ProductStatus {
  ACTIVE
  CLOSING_OUT
  DISCONTINUED
}

model Product {
  id                 String                  @id @default(cuid())
  businessId         String
  business           Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug               String
  styleCode          String // supplier style, e.g. "DM104L"
  name               String
  brand              String?
  description        String?
  status             ProductStatus           @default(ACTIVE)
  isCustom           Boolean                 @default(false) // in-house / non-supplier item
  allowBlankSale     Boolean                 @default(true)
  sizeChartHtml      String?
  sizeChartImageUrl  String?
  specSheetUrl       String?
  productionLeadDays Int? // overrides method lead days when set
  supplierId         String?
  supplier           Supplier?               @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: NoAction)
  productTypeId      String
  productType        ProductType             @relation(fields: [businessId, productTypeId], references: [businessId, id], onDelete: NoAction)
  quantityDiscountId String?
  quantityDiscount   QuantityDiscount?       @relation(fields: [businessId, quantityDiscountId], references: [businessId, id], onDelete: NoAction)
  categories         ProductCategory[]
  colors             ProductColor[]
  sizes              ProductSize[]
  variants           ProductVariant[]
  views              ProductView[]
  methodRules        ProductDecorationRule[]
  designs            Design[]
  externalSource     String?
  externalId         String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, slug])
  @@unique([businessId, externalSource, externalId])
  @@index([businessId, supplierId, styleCode])
}

model ProductCategory {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  categoryId String
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  category   Category @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Cascade)

  @@id([productId, categoryId])
}

enum GarmentShade {
  WHITE
  LIGHT
  DARK
}

model ProductColor {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  name       String
  hex        String?
  shade      GarmentShade     @default(LIGHT) // drives white-underbase rules
  sortOrder  Int              @default(0)
  variants   ProductVariant[]
  images     ViewImage[]
  designs    Design[]

  @@unique([businessId, id])
  // Lets a design require that its color belongs to its product.
  @@unique([productId, id])
  @@unique([productId, name])
}

model ProductSize {
  id              String           @id @default(cuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  code            String // "S", "2XL", "YM"
  label           String
  sortOrder       Int              @default(0)
  variants        ProductVariant[]
  lineSizes       OrderLineSize[]
  lineNames       OrderLineName[]
  storeItemPrices StoreItemPrice[]

  @@unique([businessId, id])
  @@unique([productId, code])
}

model ProductVariant {
  id             String              @id @default(cuid())
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId      String
  product        Product             @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  colorId        String
  color          ProductColor        @relation(fields: [businessId, colorId], references: [businessId, id], onDelete: Cascade)
  sizeId         String
  size           ProductSize         @relation(fields: [businessId, sizeId], references: [businessId, id], onDelete: Cascade)
  sku            String
  supplierSku    String?
  wholesaleCost  Decimal             @db.Decimal(10, 2)
  stockOnHand    Int? // null = not stocked in-house
  reorderPoint   Int? // low-stock alert at or below this
  supplierStock  Int?
  active         Boolean             @default(true)
  externalSource String?
  externalId     String?
  updatedAt      DateTime            @updatedAt
  poLines        PurchaseOrderLine[]
  allocations    BlankAllocation[]
  stockMovements StockMovement[]

  @@unique([businessId, id])
  @@unique([businessId, sku])
  @@unique([productId, colorId, sizeId])
  @@unique([businessId, externalSource, externalId])
}

model ProductView {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  name       String // "Front", "Back", "Left Sleeve"
  sortOrder  Int              @default(0)
  areas      DecorationArea[]
  images     ViewImage[]

  @@unique([businessId, id])
  @@unique([productId, name])
}

model ViewImage {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  viewId     String
  view       ProductView  @relation(fields: [businessId, viewId], references: [businessId, id], onDelete: Cascade)
  colorId    String
  color      ProductColor @relation(fields: [businessId, colorId], references: [businessId, id], onDelete: Cascade)
  url        String

  @@unique([viewId, colorId])
}

model DecorationArea {
  id                String             @id @default(cuid())
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  viewId            String
  view              ProductView        @relation(fields: [businessId, viewId], references: [businessId, id], onDelete: Cascade)
  name              String // "Full Front", "Left Chest"
  widthIn           Decimal            @db.Decimal(6, 2)
  heightIn          Decimal            @db.Decimal(6, 2)
  // Placement on the view image, as fractions of image width/height (0–1).
  x                 Float
  y                 Float
  w                 Float
  h                 Float
  designDecorations DesignDecoration[]

  @@unique([businessId, id])
}

// ─── Decoration methods ─────────────────────────────────────────────────────

enum DecorationKind {
  SCREEN_PRINT
  EMBROIDERY
  DTF
  DIGITAL
  VINYL
  TRANSFER
  ENGRAVING
  OTHER
}

// How the decoration unit price is looked up in its price table.
enum DecorationPricingModel {
  PER_COLOR // dimension = ink colors (screen printing)
  PER_STITCH // dimension = stitch count (embroidery)
  AREA // dimension = square inches of artwork
  FLAT // no dimension; price by quantity only
}

model DecorationMethod {
  id                    String                  @id @default(cuid())
  businessId            String
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code                  String // "SCR", "EMB", "DTF"
  name                  String
  shortName             String
  description           String?
  kind                  DecorationKind
  pricingModel          DecorationPricingModel
  active                Boolean                 @default(true)
  sortOrder             Int                     @default(0)
  minQty                Int                     @default(1)
  maxColors             Int?
  minDpi                Int?
  perfectDpi            Int?
  productionLeadDays    Int                     @default(14)
  dailyCapacity         Int? // pieces per day, for the production calendar
  // Fees (per job unless noted)
  screenSetupFee        Decimal                 @default(0) @db.Decimal(10, 2) // per screen
  chargeWhiteBaseScreen Boolean                 @default(true)
  useWhiteBaseOnDark    Boolean                 @default(true)
  artworkFee            Decimal                 @default(0) @db.Decimal(10, 2)
  digitizingFee         Decimal                 @default(0) @db.Decimal(10, 2)
  digitizingFeePerInch  Boolean                 @default(false)
  proofingFee           Decimal                 @default(0) @db.Decimal(10, 2)
  combineSameDesignQty  Boolean                 @default(false)
  // Design-tool capabilities (text, images, team names, effects, palettes…).
  capabilities          Json                    @default("{}")
  priceTables           DecorationPriceTable[]
  productTypes          ProductTypeDecoration[]
  productRules          ProductDecorationRule[]
  designDecorations     DesignDecoration[]
  workflowSteps         WorkflowStep[]
  productionJobs        ProductionJob[]
  externalSource        String?
  externalId            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, code])
  @@unique([businessId, externalSource, externalId])
}

model ProductTypeDecoration {
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productTypeId String
  methodId      String
  productType   ProductType      @relation(fields: [businessId, productTypeId], references: [businessId, id], onDelete: Cascade)
  method        DecorationMethod @relation(fields: [businessId, methodId], references: [businessId, id], onDelete: Cascade)

  @@id([productTypeId, methodId])
}

// Per-product overrides: disable a method, or change its minimum quantity.
model ProductDecorationRule {
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  methodId   String
  enabled    Boolean          @default(true)
  minQty     Int?
  product    Product          @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  method     DecorationMethod @relation(fields: [businessId, methodId], references: [businessId, id], onDelete: Cascade)

  @@id([productId, methodId])
}

// A grid of unit prices: rows by minimum quantity, columns by dimension
// (colors, stitches, or square inches). FLAT tables use dimensionMax = null.
model DecorationPriceTable {
  id             String                @id @default(cuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  methodId       String
  method         DecorationMethod      @relation(fields: [businessId, methodId], references: [businessId, id], onDelete: Cascade)
  pricingGroupId String? // null = default table for the method
  pricingGroup   PricingGroup?         @relation(fields: [businessId, pricingGroupId], references: [businessId, id], onDelete: Cascade)
  name           String
  // Seeded tables start as placeholders; saving real prices clears this.
  isPlaceholder  Boolean               @default(false)
  cells          DecorationPriceCell[]

  @@unique([businessId, id])
  @@unique([methodId, pricingGroupId])
}

model DecorationPriceCell {
  id           String               @id @default(cuid())
  businessId   String
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tableId      String
  table        DecorationPriceTable @relation(fields: [businessId, tableId], references: [businessId, id], onDelete: Cascade)
  minQty       Int
  dimensionMax Decimal?             @db.Decimal(10, 2) // up to N colors / stitches / sq in
  unitPrice    Decimal              @db.Decimal(10, 2)

  @@unique([tableId, minQty, dimensionMax])
}

// ─── Pricing ────────────────────────────────────────────────────────────────

enum MarkupMode {
  MARKUP // price = cost × (1 + pct)
  MARGIN // price = cost ÷ (1 − pct)
}

model PricingGroup {
  id             String                 @id @default(cuid())
  businessId     String
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean                @default(false)
  markupMode     MarkupMode             @default(MARKUP)
  markupTiers    MarkupTier[]
  priceTables    DecorationPriceTable[]
  companies      Company[]
  customers      Customer[]
  orders         Order[]
  externalSource String?
  externalId     String?

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@unique([businessId, externalSource, externalId])
}

model MarkupTier {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pricingGroupId String
  pricingGroup   PricingGroup @relation(fields: [businessId, pricingGroupId], references: [businessId, id], onDelete: Cascade)
  costFrom       Decimal      @db.Decimal(10, 2)
  costTo         Decimal?     @db.Decimal(10, 2) // null = no upper bound
  pct            Decimal      @db.Decimal(6, 4) // 0.55 = 55%
}

model QuantityDiscount {
  id         String                 @id @default(cuid())
  businessId String
  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  tiers      QuantityDiscountTier[]
  products   Product[]

  @@unique([businessId, id])
  @@unique([businessId, name])
}

model QuantityDiscountTier {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  discountId String
  discount   QuantityDiscount @relation(fields: [businessId, discountId], references: [businessId, id], onDelete: Cascade)
  minQty     Int
  pct        Decimal          @db.Decimal(6, 4) // 0.10 = 10% off

  @@unique([discountId, minQty])
}

model TaxRate {
  id                  String   @id @default(cuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  rate                Decimal  @db.Decimal(7, 5) // 0.055 = 5.5%
  country             String   @default("US")
  region              String? // state/province code; null = whole country
  postalPrefixes      String[] // empty = whole region
  active              Boolean  @default(true)
  taxShipping         Boolean  @default(false)
  taxArtworkFee       Boolean  @default(true)
  taxDigitizingFee    Boolean  @default(true)
  taxRushFee          Boolean  @default(true)
  taxScreenSetupFee   Boolean  @default(true)
  taxPaymentSurcharge Boolean  @default(false)

  @@index([businessId])
}

// ─── Customers ──────────────────────────────────────────────────────────────

model Company {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  website        String?
  notes          String?
  taxExempt      Boolean        @default(false)
  pricingGroupId String?
  pricingGroup   PricingGroup?  @relation(fields: [businessId, pricingGroupId], references: [businessId, id], onDelete: NoAction)
  customers      Customer[]
  orders         Order[]
  artwork        ArtworkAsset[]
  externalSource String?
  externalId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, externalSource, externalId])
  @@index([businessId, name])
}

model Customer {
  id              String            @id @default(cuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String            @default("")
  email           String?
  phone           String?
  notes           String?
  // Unset = inherit from the company.
  taxExempt       Boolean?
  pricingGroupId  String?
  pricingGroup    PricingGroup?     @relation(fields: [businessId, pricingGroupId], references: [businessId, id], onDelete: NoAction)
  companyId       String?
  company         Company?          @relation(fields: [businessId, companyId], references: [businessId, id], onDelete: NoAction)
  addresses       Address[]
  orders          Order[]
  designs         Design[]
  // Shopper account: set once they've proved the email is theirs.
  passwordHash    String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  sessions        CustomerSession[]
  tokens          CustomerToken[]
  carts           Cart[]
  stores          Store[]           @relation("StoreCustomer")
  artwork         ArtworkAsset[]
  externalSource  String?
  externalId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  storeContacts   StoreContact[]
  storeRequests   StoreRequest[]
  leads           Lead[]
  tasks           Task[]

  @@unique([businessId, id])
  @@unique([businessId, externalSource, externalId])
  @@index([businessId, email])
  @@index([businessId, lastName, firstName])
}

// ─── Leads ───────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED // a real opportunity: they need something and can buy
  CONVERTED // became a customer (and usually a quote)
  LOST
}

// Someone who might buy but hasn't yet: a phone call, a trade-show card, a
// website quote request from a newcomer. Converting makes (or links) the
// customer and company, and can start a quote.
model Lead {
  id             String      @id @default(cuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String      @default("")
  organization   String? // school, team, business…
  title          String? // "Athletic director"
  email          String?
  phone          String?
  source         String? // "Phone", "Referral", "Website quote request"…
  interest       String? // what they're after: "Spring soccer uniforms, ~60 pieces"
  estimatedValue Decimal?    @db.Decimal(10, 2)
  status         LeadStatus  @default(NEW)
  lostReason     String?
  ownerId        String?
  owner          StaffUser?  @relation("LeadOwner", fields: [businessId, ownerId], references: [businessId, id], onDelete: NoAction)
  createdById    String?
  createdBy      StaffUser?  @relation("LeadCreator", fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  customerId     String?
  customer       Customer?   @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: NoAction)
  quoteId        String?
  quote          Order?      @relation("LeadQuote", fields: [businessId, quoteId], references: [businessId, id], onDelete: NoAction)
  lastContactAt  DateTime?
  convertedAt    DateTime?
  events         LeadEvent[]
  tasks          Task[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, email])
}

enum LeadEventType {
  CREATED
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS // status, owner or details changed
  CONVERTED
}

model LeadEvent {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead          @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Cascade)
  type       LeadEventType
  body       String
  staffId    String?
  staff      StaffUser?    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: NoAction)
  createdAt  DateTime      @default(now())

  @@index([leadId, createdAt])
}

// A follow-up: something someone has to do by a day, for a lead, customer,
// quote or order (or nothing in particular).
model Task {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  dueDate     DateTime?  @db.Date
  assigneeId  String?
  assignee    StaffUser? @relation("TaskAssignee", fields: [businessId, assigneeId], references: [businessId, id], onDelete: NoAction)
  createdById String?
  createdBy   StaffUser? @relation("TaskCreator", fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  leadId      String?
  lead        Lead?      @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  orderId     String?
  order       Order?     @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  doneAt      DateTime?
  doneById    String?
  doneBy      StaffUser? @relation("TaskDoneBy", fields: [businessId, doneById], references: [businessId, id], onDelete: NoAction)
  // Set on tasks made automatically ("quote-follow-up:<orderId>"), so each is made once.
  autoKey     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([businessId, autoKey])
  @@index([businessId, assigneeId, doneAt])
  @@index([leadId])
  @@index([customerId])
  @@index([orderId])
}

// ─── Automations ──────────────────────────────────────────────────────────

enum AutomationTrigger {
  QUOTE_CREATED
  ORDER_CREATED
  ONLINE_ORDER // placed in a store
  STATUS_CHANGED
  ORDER_PAID // paid in full
  PROOF_APPROVED
  PROOF_CHANGES // the customer asked for changes to a proof
  LEAD_CREATED
  STORE_REQUEST
}

// "When this happens (and these conditions hold), do these things."
// Conditions and actions are JSON, checked by lib/automation/rules.ts.
model AutomationRule {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  active     Boolean           @default(true)
  trigger    AutomationTrigger
  conditions Json              @default("{}")
  actions    Json              @default("[]")
  runs       AutomationRun[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([businessId, id])
  @@index([businessId, trigger, active])
}

// Something that happened, queued with the change that caused it and
// handled right after the request (or by the hourly sweep).
model AutomationEvent {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  trigger     AutomationTrigger
  orderId     String?
  leadId      String?
  requestId   String?
  statusId    String?
  // How many automations led to this one (stops rules setting each other off forever).
  depth       Int               @default(0)
  // The address the request came in on, for links in emails.
  origin      String?
  createdAt   DateTime          @default(now())
  processedAt DateTime?
  runs        AutomationRun[]

  @@unique([businessId, id])
  @@index([processedAt, createdAt])
}

model AutomationRun {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ruleId     String
  rule       AutomationRule  @relation(fields: [businessId, ruleId], references: [businessId, id], onDelete: Cascade)
  eventId    String
  event      AutomationEvent @relation(fields: [businessId, eventId], references: [businessId, id], onDelete: Cascade)
  ok         Boolean
  message    String // what it did, or what went wrong
  createdAt  DateTime        @default(now())

  @@index([ruleId, createdAt])
}

model Address {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  label      String? // "Office", "Warehouse"
  name       String
  line1      String
  line2      String?
  city       String
  region     String // state / province code
  postalCode String
  country    String   @default("US")
  isDefault  Boolean  @default(false)
}

// ─── Designs ────────────────────────────────────────────────────────────────
// A decorated product: product + color + decorations. Quote/order lines point
// at a design, and (later) affiliate store products point at the same
// designs, which is what lets a quote be published to a store.

model Design {
  id          String             @id @default(cuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  productId   String
  product     Product            @relation(fields: [businessId, productId], references: [businessId, id], onDelete: NoAction)
  colorId     String
  // The color must belong to the design's product.
  color       ProductColor       @relation(fields: [productId, colorId], references: [productId, id], onDelete: NoAction)
  customerId  String?
  customer    Customer?          @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: NoAction)
  decorations DesignDecoration[]
  orderLines  OrderLine[]
  storeItems  StoreItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([businessId, id])
}

model DesignDecoration {
  id              String           @id @default(cuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  designId        String
  design          Design           @relation(fields: [businessId, designId], references: [businessId, id], onDelete: Cascade)
  methodId        String
  method          DecorationMethod @relation(fields: [businessId, methodId], references: [businessId, id], onDelete: NoAction)
  areaId          String?
  area            DecorationArea?  @relation(fields: [businessId, areaId], references: [businessId, id], onDelete: NoAction)
  location        String // "Front / Full Front"; kept even if the area is removed
  colors          Int? // ink colors (screen print)
  stitches        Int? // embroidery
  widthIn         Decimal?         @db.Decimal(6, 2)
  heightIn        Decimal?         @db.Decimal(6, 2)
  inkColors       String[] // names, e.g. ["White", "Pantone 186 C"]
  needsArtwork    Boolean          @default(false)
  needsDigitizing Boolean          @default(false)
  reuseScreens    Boolean          @default(false)
  notes           String?
  sortOrder       Int              @default(0)
  // Artwork as placed: the edited image shown in mockups, the original
  // upload it came from, and the edits applied (so they can be redone).
  artworkFileId   String?
  artwork         StoredFile?      @relation("DecorationArtwork", fields: [businessId, artworkFileId], references: [businessId, id], onDelete: NoAction)
  sourceFileId    String?
  source          StoredFile?      @relation("DecorationArtSource", fields: [businessId, sourceFileId], references: [businessId, id], onDelete: NoAction)
  artEdits        Json             @default("{}")
  // Artwork's pixel size, for print resolution (DPI) checks.
  artWidthPx      Int?
  artHeightPx     Int?
  // Placement inside the print area's box, as fractions of the box: left and
  // top edge of the artwork and its width (height follows its shape).
  placeX          Float?
  placeY          Float?
  placeW          Float?
  rotation        Float            @default(0) // degrees, clockwise
}

// ─── Quotes & orders ────────────────────────────────────────────────────────

enum OrderType {
  QUOTE
  ORDER
}

// What a status means to the system, so customer actions can move a
// quote/order along automatically. Each role is used by at most one status.
enum StatusRole {
  QUOTE_SENT // set when a quote is emailed to the customer
  QUOTE_APPROVED // the customer approved the quote online
  QUOTE_CHANGES_REQUESTED // the customer asked for changes to the quote
  QUOTE_CONVERTED // the quote became an order
  ORDER_PROOF_SENT // a proof was sent for approval
  ORDER_ARTWORK_APPROVED
  ORDER_BLANKS_ORDERED
  ORDER_IN_PRODUCTION
  ORDER_READY
  ORDER_FULFILLED // the customer approved the latest proof
  ORDER_CHANGES_REQUESTED // the customer asked for changes to a proof
}

// Editable list of statuses per type, so the workflow can match how staff work.
model OrderStatus {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       OrderType
  name       String
  color      String      @default("#9CA3AF")
  sortOrder  Int         @default(0)
  isDefault  Boolean     @default(false) // status for new quotes/orders
  isClosed   Boolean     @default(false) // done, cancelled, declined, converted
  role       StatusRole?
  orders     Order[]

  @@unique([businessId, id])
  @@unique([businessId, type, name])
  @@unique([businessId, role])
}

model Order {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type             OrderType
  number           Int // per business and type: quotes Q-1001…, orders 1001…
  title            String?
  customerId       String
  customer         Customer          @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: NoAction)
  companyId        String?
  company          Company?          @relation(fields: [businessId, companyId], references: [businessId, id], onDelete: NoAction)
  statusId         String
  status           OrderStatus       @relation(fields: [businessId, statusId], references: [businessId, id], onDelete: NoAction)
  assignedToId     String?
  assignedTo       StaffUser?        @relation("OrderAssignee", fields: [businessId, assignedToId], references: [businessId, id], onDelete: NoAction)
  createdById      String?
  createdBy        StaffUser?        @relation("OrderCreator", fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  pricingGroupId   String?
  pricingGroup     PricingGroup?     @relation(fields: [businessId, pricingGroupId], references: [businessId, id], onDelete: NoAction)
  dueDate          DateTime?         @db.Date
  rush             Boolean           @default(false)
  taxExempt        Boolean           @default(false)
  customerNotes    String? // shown on the quote/order the customer sees
  // Ship-to, copied onto the order so later address edits don't change it.
  shipName         String?
  shipLine1        String?
  shipLine2        String?
  shipCity         String?
  shipRegion       String?
  shipPostalCode   String?
  shipCountry      String            @default("US")
  // Price snapshot, recalculated whenever the order changes.
  shipping         Decimal           @default(0) @db.Decimal(10, 2)
  merchandise      Decimal           @default(0) @db.Decimal(10, 2)
  feesTotal        Decimal           @default(0) @db.Decimal(10, 2)
  rushFee          Decimal           @default(0) @db.Decimal(10, 2)
  tax              Decimal           @default(0) @db.Decimal(10, 2)
  total            Decimal           @default(0) @db.Decimal(10, 2)
  pricedAt         DateTime?
  // Customer-facing link (quote approval, order status, invoice). Random and
  // unguessable; created the first time it's needed.
  publicToken      String?           @unique
  approvedAt       DateTime?
  approvedByName   String?
  // Deposit the customer must pay before production (amount).
  depositRequired  Decimal           @default(0) @db.Decimal(10, 2)
  // Sum of payments minus refunds, kept up to date with each payment.
  paidTotal        Decimal           @default(0) @db.Decimal(10, 2)
  invoiceNumber    Int?
  invoicedAt       DateTime?
  invoiceDueDate   DateTime?         @db.Date
  deliveryMethodId String?
  deliveryMethod   DeliveryMethod?   @relation(fields: [businessId, deliveryMethodId], references: [businessId, id], onDelete: NoAction)
  // Where it came from: the back office, a storefront checkout, or a quote request form.
  source           OrderSource       @default(STAFF)
  storeId          String?
  store            Store?            @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: NoAction)
  placedAt         DateTime? // when a shopper placed it online
  // The store owner's commission on this order, worked out when it was placed.
  commission       Decimal           @default(0) @db.Decimal(10, 2)
  // Store orders waiting for the store's batch (made at close), and the batch they went into.
  heldForBatch     Boolean           @default(false)
  batchId          String?
  batch            StoreBatch?       @relation("BatchedOrders", fields: [businessId, batchId], references: [businessId, id], onDelete: NoAction)
  // The batch this order produces (orders made from a store's batch).
  producesBatch    StoreBatch?       @relation("BatchProductionOrder")
  // Promo code discount, taken off before tax.
  discount         Decimal           @default(0) @db.Decimal(10, 2)
  promoCodeId      String?
  promoCode        PromoCode?        @relation(fields: [businessId, promoCodeId], references: [businessId, id], onDelete: NoAction)
  giftCodeUses     GiftCodeUse[]
  carts            Cart[]
  readyNotifiedAt  DateTime? // "ready for pickup" email sent
  productionJobs   ProductionJob[]
  blankAllocations BlankAllocation[]
  stockMovements   StockMovement[]
  shipments        Shipment[]
  files            OrderFile[]
  proofs           Proof[]
  payments         Payment[]
  emails           EmailMessage[]
  // A quote converted to an order points at the order it became.
  quoteId          String?
  quote            Order?            @relation("QuoteToOrder", fields: [businessId, quoteId], references: [businessId, id], onDelete: NoAction)
  convertedTo      Order?            @relation("QuoteToOrder")
  lines            OrderLine[]
  events           OrderEvent[]
  externalSource   String?
  externalId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fromRequests     StoreRequest[]    @relation("RequestQuote")
  fromLeads        Lead[]            @relation("LeadQuote")
  tasks            Task[]

  @@unique([businessId, id])
  @@unique([businessId, type, number])
  @@unique([businessId, quoteId])
  @@unique([businessId, externalSource, externalId])
  @@index([businessId, statusId])
  @@index([businessId, assignedToId])
  @@index([businessId, customerId])
  @@index([storeId, heldForBatch])
}

model OrderLine {
  id             String          @id @default(cuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order           @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  sortOrder      Int             @default(0)
  designId       String
  design         Design          @relation(fields: [businessId, designId], references: [businessId, id], onDelete: NoAction)
  notes          String?
  // Price snapshot
  decorationUnit Decimal         @default(0) @db.Decimal(10, 2)
  discountPct    Decimal         @default(0) @db.Decimal(6, 4)
  fees           Json            @default("[]") // [{type, location, description, amount}]
  feesTotal      Decimal         @default(0) @db.Decimal(10, 2)
  total          Decimal         @default(0) @db.Decimal(10, 2) // merchandise + fees
  issues         Json            @default("[]") // pricing problems to show staff
  // Store purchases keep the store's price instead of being repriced.
  fixedPrice     Boolean         @default(false)
  storeItemId    String?
  storeItem      StoreItem?      @relation(fields: [businessId, storeItemId], references: [businessId, id], onDelete: NoAction)
  sizes          OrderLineSize[]
  names          OrderLineName[] // names and numbers to print (a roster)
  shipmentItems  ShipmentItem[]

  @@unique([businessId, id])
}

model OrderLineSize {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lineId     String
  line       OrderLine   @relation(fields: [businessId, lineId], references: [businessId, id], onDelete: Cascade)
  sizeId     String
  size       ProductSize @relation(fields: [businessId, sizeId], references: [businessId, id], onDelete: NoAction)
  qty        Int
  unitPrice  Decimal     @default(0) @db.Decimal(10, 2)
  total      Decimal     @default(0) @db.Decimal(10, 2)

  @@unique([lineId, sizeId])
}

// A name and/or number printed on some of a line's pieces (team rosters).
// `charge` is what each piece was sold with on top of its price (store
// orders); it's 0 when staff enter a roster on an order.
model OrderLineName {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lineId     String
  line       OrderLine   @relation(fields: [businessId, lineId], references: [businessId, id], onDelete: Cascade)
  sizeId     String
  size       ProductSize @relation(fields: [businessId, sizeId], references: [businessId, id], onDelete: NoAction)
  name       String      @default("")
  number     String      @default("")
  qty        Int         @default(1)
  charge     Decimal     @default(0) @db.Decimal(10, 2)
  sortOrder  Int         @default(0)

  @@index([lineId])
}

enum OrderEventType {
  CREATED
  NOTE
  STATUS
  ASSIGNED
  EDITED
  CONVERTED
  EMAIL // an email was sent to the customer
  CUSTOMER // the customer approved or asked for changes
  FILE // files added or removed
  PROOF // a proof was created, sent or cancelled
  PAYMENT // a payment or refund was recorded
  INVOICE // an invoice was issued
  PRODUCTION // production jobs created, steps done, scheduled
  PURCHASING // blanks ordered, received or taken from stock
  SHIPMENT // shipped, picked up or delivered
  STORE // published to a store
}

model OrderEvent {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order          @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  type       OrderEventType
  body       String
  staffId    String?
  staff      StaffUser?     @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: NoAction)
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
}

// Sequential document numbers (quotes, orders), per business.
model Counter {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key        String
  value      Int

  @@id([businessId, key])
}

// ─── Files, proofs, payments, email ─────────────────────────────────────────

// A stored upload (artwork, mockup, customer file). The bytes live in file
// storage under storageKey; this row is the business's record of it.
model StoredFile {
  id            String             @id @default(cuid())
  businessId    String
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String // original filename
  contentType   String
  size          Int
  sha256        String
  storageKey    String             @unique
  uploadedById  String?
  uploadedBy    StaffUser?         @relation(fields: [businessId, uploadedById], references: [businessId, id], onDelete: NoAction)
  orderFiles    OrderFile[]
  proofFiles    ProofFile[]
  storeLogos    Store[]            @relation("StoreLogo")
  storeHeroes   Store[]            @relation("StoreHero")
  storeItems    StoreItem[]
  artworkFor    DesignDecoration[] @relation("DecorationArtwork")
  artSourceFor  DesignDecoration[] @relation("DecorationArtSource")
  artworkAssets ArtworkAsset[]
  createdAt     DateTime           @default(now())

  @@unique([businessId, id])
}

// A customer's artwork, kept for reuse in the design studio: images they or
// staff have uploaded that can be placed on products. Visible to everyone at
// the customer's company too.
model ArtworkAsset {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fileId     String
  file       StoredFile @relation(fields: [businessId, fileId], references: [businessId, id], onDelete: Cascade)
  customerId String?
  customer   Customer?  @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  companyId  String?
  company    Company?   @relation(fields: [businessId, companyId], references: [businessId, id], onDelete: Cascade)
  name       String
  lastUsedAt DateTime?
  createdAt  DateTime   @default(now())

  @@unique([businessId, fileId])
  @@index([businessId, customerId])
  @@index([businessId, companyId])
}

enum OrderFileKind {
  ARTWORK // customer's or shop's artwork as received
  PRODUCTION // print-ready / digitized files
  MOCKUP // product previews
  CUSTOMER // sent by the customer with a response
  OTHER
}

model OrderFile {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order         @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  fileId     String
  file       StoredFile    @relation(fields: [businessId, fileId], references: [businessId, id], onDelete: Cascade)
  kind       OrderFileKind @default(ARTWORK)
  note       String?
  createdAt  DateTime      @default(now())

  @@unique([orderId, fileId])
  @@index([businessId, orderId])
}

enum ProofStatus {
  DRAFT
  SENT
  APPROVED
  CHANGES_REQUESTED
  CANCELLED
}

// An artwork proof sent to the customer for approval.
model Proof {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order       @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  number        Int // 1, 2, 3… per order
  token         String      @unique // customer link; random and unguessable
  status        ProofStatus @default(DRAFT)
  message       String? // note to the customer
  sentAt        DateTime?
  respondedAt   DateTime?
  responderName String?
  responseNote  String?
  createdById   String?
  createdBy     StaffUser?  @relation(fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  files         ProofFile[]
  createdAt     DateTime    @default(now())

  @@unique([businessId, id])
  @@unique([orderId, number])
}

model ProofFile {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  proofId      String
  proof        Proof      @relation(fields: [businessId, proofId], references: [businessId, id], onDelete: Cascade)
  fileId       String
  file         StoredFile @relation(fields: [businessId, fileId], references: [businessId, id], onDelete: Cascade)
  fromCustomer Boolean    @default(false) // attached by the customer with their response
  sortOrder    Int        @default(0)

  @@unique([proofId, fileId])
}

enum PaymentMethod {
  CASH
  CHECK
  CARD // taken in person or by phone
  BANK_TRANSFER
  ONLINE // paid online by card (Stripe)
  GIFT_CARD // a gift code redeemed at checkout
  OTHER
}

// A payment (positive) or refund (negative) against an order.
model Payment {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order         @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  reference  String? // check number, last 4 digits, transaction id
  note       String?
  receivedAt DateTime      @default(now())
  staffId    String?
  staff      StaffUser?    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: NoAction)
  createdAt  DateTime      @default(now())

  @@index([businessId, orderId])
}

enum EmailStatus {
  SENT
  FAILED
  LOGGED // no email provider configured (development): recorded, not sent
}

// Every email the app sends on a business's behalf.
model EmailMessage {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?         @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: NoAction)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [businessId, purchaseOrderId], references: [businessId, id], onDelete: NoAction)
  to              String
  subject         String
  text            String
  html            String
  status          EmailStatus
  provider        String
  error           String?
  createdAt       DateTime       @default(now())

  @@index([businessId, orderId])
  @@index([businessId, purchaseOrderId])
}

// ─── Production ──────────────────────────────────────────────────────────

// A decoration method's production steps, e.g. Burn screens → Print → Cure.
model WorkflowStep {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  methodId   String
  method     DecorationMethod @relation(fields: [businessId, methodId], references: [businessId, id], onDelete: Cascade)
  name       String
  sortOrder  Int              @default(0)

  @@unique([businessId, id])
}

enum JobStatus {
  QUEUED
  IN_PROGRESS
  DONE
}

// One job per order and decoration method. Its steps are copied from the
// method's workflow when the job is created, so later workflow edits don't
// change jobs already on the floor.
model ProductionJob {
  id           String              @id @default(cuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order               @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  methodId     String
  method       DecorationMethod    @relation(fields: [businessId, methodId], references: [businessId, id], onDelete: NoAction)
  status       JobStatus           @default(QUEUED)
  scheduledFor DateTime?           @db.Date
  assignedToId String?
  assignedTo   StaffUser?          @relation("JobAssignee", fields: [businessId, assignedToId], references: [businessId, id], onDelete: NoAction)
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  steps        ProductionJobStep[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([businessId, id])
  @@unique([orderId, methodId])
  @@index([businessId, status, scheduledFor])
}

model ProductionJobStep {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId      String
  job        ProductionJob @relation(fields: [businessId, jobId], references: [businessId, id], onDelete: Cascade)
  name       String
  sortOrder  Int           @default(0)
  doneAt     DateTime?
  doneById   String?
  doneBy     StaffUser?    @relation(fields: [businessId, doneById], references: [businessId, id], onDelete: NoAction)

  @@unique([businessId, id])
}

// ─── Purchasing & inventory ──────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL // some items received
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number         Int // PO-1001…
  supplierId     String
  supplier       Supplier            @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: NoAction)
  status         PurchaseOrderStatus @default(DRAFT)
  shipToName     String?
  shipLine1      String?
  shipLine2      String?
  shipCity       String?
  shipRegion     String?
  shipPostalCode String?
  shipCountry    String              @default("US")
  // Ship without supplier branding or invoice in the box (straight to a customer).
  blindShip      Boolean             @default(false)
  notes          String? // printed on the PO
  expectedAt     DateTime?           @db.Date
  sentAt         DateTime?
  receivedAt     DateTime?
  total          Decimal             @default(0) @db.Decimal(10, 2)
  createdById    String?
  createdBy      StaffUser?          @relation(fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  lines          PurchaseOrderLine[]
  emails         EmailMessage[]
  stockMovements StockMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, number])
  @@index([businessId, status])
}

model PurchaseOrderLine {
  id              String            @id @default(cuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder     @relation(fields: [businessId, purchaseOrderId], references: [businessId, id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant    @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: NoAction)
  qty             Int
  unitCost        Decimal           @db.Decimal(10, 2)
  qtyReceived     Int               @default(0)
  allocations     BlankAllocation[]

  @@unique([businessId, id])
  @@unique([purchaseOrderId, variantId])
}

enum BlankSource {
  PO // on a purchase order line
  STOCK // taken from in-house stock
  OTHER // supplied by the customer or already on hand, not tracked
}

// Blanks set aside for an order.
model BlankAllocation {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order              @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant     @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: NoAction)
  qty        Int
  source     BlankSource
  poLineId   String? // set when source is PO
  poLine     PurchaseOrderLine? @relation(fields: [businessId, poLineId], references: [businessId, id], onDelete: Cascade)
  note       String?
  createdAt  DateTime           @default(now())

  @@unique([businessId, id])
  @@index([businessId, orderId])
  @@index([businessId, variantId])
}

enum StockReason {
  RECEIVED // from a purchase order
  ADJUSTED // counted or corrected by hand
  USED // taken for an order
  RETURNED // an order gave blanks back
}

// Every change to in-house stock, for the history on the inventory page.
model StockMovement {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: Cascade)
  change          Int
  reason          StockReason
  note            String?
  orderId         String?
  order           Order?         @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: NoAction)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [businessId, purchaseOrderId], references: [businessId, id], onDelete: NoAction)
  staffId         String?
  staff           StaffUser?     @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: NoAction)
  createdAt       DateTime       @default(now())

  @@index([businessId, variantId])
}

// ─── Shipping ────────────────────────────────────────────────────────────

enum DeliveryKind {
  SHIP
  PICKUP
  DELIVERY // local delivery by the shop
}

// The business-wide list of delivery options, used on orders now and
// offered by storefronts later.
model DeliveryMethod {
  id          String                @id @default(cuid())
  businessId  String
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  kind        DeliveryKind          @default(SHIP)
  description String?
  price       Decimal               @default(0) @db.Decimal(10, 2)
  freeOver    Decimal?              @db.Decimal(10, 2) // free when the order's items reach this
  // Carrier and service codes, e.g. for ShipStation ("ups_walleted", "ups_ground").
  carrier     String?
  service     String?
  active      Boolean               @default(true)
  sortOrder   Int                   @default(0)
  orders      Order[]
  shipments   Shipment[]
  stores      StoreDeliveryMethod[]
  carts       Cart[]

  @@unique([businessId, id])
  @@unique([businessId, name])
}

model Shipment {
  id               String          @id @default(cuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order           @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  kind             DeliveryKind
  deliveryMethodId String?
  deliveryMethod   DeliveryMethod? @relation(fields: [businessId, deliveryMethodId], references: [businessId, id], onDelete: NoAction)
  methodName       String? // snapshot, in case the method is renamed or removed
  carrier          String? // "ups", "usps", "fedex", "dhl" or free text
  trackingNumber   String?
  cost             Decimal?        @db.Decimal(10, 2) // what the shop paid
  note             String? // e.g. who picked it up
  shippedAt        DateTime        @default(now())
  notifiedAt       DateTime?
  createdById      String?
  createdBy        StaffUser?      @relation(fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  items            ShipmentItem[]
  createdAt        DateTime        @default(now())

  @@unique([businessId, id])
  @@index([businessId, orderId])
}

model ShipmentItem {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shipmentId  String
  shipment    Shipment   @relation(fields: [businessId, shipmentId], references: [businessId, id], onDelete: Cascade)
  // Cleared if the line is later removed from the order; the description stays.
  lineId      String?
  line        OrderLine? @relation(fields: [businessId, lineId], references: [businessId, id], onDelete: NoAction)
  sizeId      String
  description String // "Gildan 5000 · Navy · M"
  qty         Int
}

// ─── Storefront ──────────────────────────────────────────────────────────

enum OrderSource {
  STAFF
  STOREFRONT
  QUOTE_REQUEST
  STORE_BATCH // a store's orders combined for production
}

enum AccountMode {
  OPTIONAL // shoppers may sign in or check out as guests
  REQUIRED // shoppers must sign in to check out
  GUEST_ONLY // no accounts; everyone checks out as a guest
}

enum StoreKind {
  ROOT // the business's own storefront
  AFFILIATE // a customer's store on a subdomain (phase 6)
}

enum PersonalizationMode {
  OFF
  OPTIONAL
  REQUIRED
}

enum CommissionKind {
  PERCENT // of sales after discounts, before tax and shipping
  PER_PIECE // an amount for every piece sold
}

enum MarkupKind {
  AMOUNT
  PERCENT
}

// A storefront. Every business has one ROOT store; affiliate stores share
// the same engine. Settings left empty inherit the business defaults.
model Store {
  id                    String                @id @default(cuid())
  businessId            String
  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind                  StoreKind             @default(ROOT)
  slug                  String? // subdomain label for affiliate stores; empty for the root store
  name                  String
  tagline               String?
  logoFileId            String?
  logo                  StoredFile?           @relation("StoreLogo", fields: [businessId, logoFileId], references: [businessId, id], onDelete: NoAction)
  // The look: a theme (lib/store/themes.ts) and the homepage banner.
  theme                 String                @default("minimal")
  showHero              Boolean               @default(true)
  heroImageFileId       String?
  heroImage             StoredFile?           @relation("StoreHero", fields: [businessId, heroImageFileId], references: [businessId, id], onDelete: NoAction)
  heroHeadline          String? // defaults to the store name
  heroText              String? // defaults to the tagline
  heroButton            String? // defaults to "Shop now"
  accentColor           String? // "#f59e0b"
  announcement          String? // bar across the top of every page
  footerText            String?
  active                Boolean               @default(true)
  // Affiliate stores: the customer the store is for, the staff member who
  // looks after it, its group, and when it's open.
  customerId            String?
  customer              Customer?             @relation("StoreCustomer", fields: [businessId, customerId], references: [businessId, id], onDelete: NoAction)
  managerId             String?
  manager               StaffUser?            @relation("StoreManager", fields: [businessId, managerId], references: [businessId, id], onDelete: NoAction)
  groupId               String?
  group                 StoreGroup?           @relation(fields: [businessId, groupId], references: [businessId, id], onDelete: NoAction)
  opensAt               DateTime?
  closesAt              DateTime?
  // Hold orders until the store closes, then produce them as one batch order.
  batchOrders           Boolean               @default(false)
  batches               StoreBatch[]
  // What the store's owner earns on its sales; empty = no commission.
  commissionKind        CommissionKind?
  commissionValue       Decimal?              @db.Decimal(10, 2)
  commissionPayouts     CommissionPayout[]
  // The owner portal (/owner on the store's address): which sections owners see,
  // the people who can sign in to it besides the store's customer, and their requests.
  portalSections        String[]              @default(["sales", "orders", "codes", "commission", "requests"])
  contacts              StoreContact[]
  requests              StoreRequest[]
  visitDays             StoreVisitDay[]
  // Make a draft quote for each new request.
  requestQuotes         Boolean               @default(false)
  // Listed in store showcases (owners can opt out later).
  showcase              Boolean               @default(true)
  promoCodes            PromoCodeStore[]
  giftCodes             GiftCodeStore[]
  accountMode           AccountMode?
  accessCode            String? // shoppers must enter it to see the store
  showPrices            Boolean?
  allowPayLater         Boolean?
  // Default markup on items (14.11); items can set their own.
  markupKind            MarkupKind?
  markupValue           Decimal?              @db.Decimal(10, 2)
  // Off: offer every active delivery method. On: only the ones listed.
  customDeliveryMethods Boolean               @default(false)
  deliveryMethods       StoreDeliveryMethod[]
  ga4Id                 String? // Google Analytics 4 measurement ID
  metaPixelId           String?
  pages                 StorePage[]
  items                 StoreItem[]
  carts                 Cart[]
  orders                Order[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, slug])
}

// A store's orders combined into one production order (at close, or when staff batch them).
model StoreBatch {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store      @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  number      Int // 1, 2… per store
  orderId     String
  order       Order      @relation("BatchProductionOrder", fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  orders      Order[]    @relation("BatchedOrders")
  createdById String?
  createdBy   StaffUser? @relation(fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  createdAt   DateTime   @default(now())

  @@unique([businessId, id])
  @@unique([businessId, orderId])
  @@unique([storeId, number])
}

// Commission paid to a store's owner.
model CommissionPayout {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store      @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  amount      Decimal    @db.Decimal(10, 2)
  paidOn      DateTime   @db.Date
  note        String? // "Check #1043"
  createdById String?
  createdBy   StaffUser? @relation(fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  createdAt   DateTime   @default(now())

  @@index([storeId])
}

// Someone at the store's organization (coach, booster president…) who can
// sign in to the owner portal with their shopper account.
model StoreContact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  title      String? // "Head coach"
  canManage  Boolean  @default(true) // can open the owner portal
  createdAt  DateTime @default(now())

  @@unique([storeId, customerId])
}

enum StoreRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  DECLINED
}

// A store owner asking for something (new items, a reorder, a change).
model StoreRequest {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store              @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  customerId String
  customer   Customer           @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: NoAction)
  subject    String
  body       String
  status     StoreRequestStatus @default(NEW)
  seenAt     DateTime? // when staff first opened it (unseen ones are flagged)
  reply      String? // staff's answer, shown in the portal
  quoteId    String?
  quote      Order?             @relation("RequestQuote", fields: [businessId, quoteId], references: [businessId, id], onDelete: NoAction)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([businessId, seenAt])
  @@index([storeId, createdAt])
}

// Visits to a store per day: a visit is a browser session, a view each page shown.
// Counted by a small script on store pages (so most bots don't count); no
// cookies or personal data are kept.
model StoreVisitDay {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  day        DateTime @db.Date
  visits     Int      @default(0)
  views      Int      @default(0)

  @@id([storeId, day])
}

model StoreDeliveryMethod {
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId          String
  store            Store          @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  deliveryMethodId String
  deliveryMethod   DeliveryMethod @relation(fields: [businessId, deliveryMethodId], references: [businessId, id], onDelete: Cascade)

  @@id([storeId, deliveryMethodId])
}

// A content page. The page with slug "home" is the home page.
model StorePage {
  id             String      @id @default(cuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store       @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  slug           String
  title          String
  body           String      @default("") // Markdown
  parentId       String?
  parent         StorePage?  @relation("PageTree", fields: [businessId, parentId], references: [businessId, id], onDelete: NoAction)
  children       StorePage[] @relation("PageTree")
  showInNav      Boolean     @default(false)
  navOrder       Int         @default(0)
  published      Boolean     @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([businessId, id])
  @@unique([storeId, slug])
}

// A decorated product for sale in a store, priced per size.
model StoreItem {
  id                      String              @id @default(cuid())
  businessId              String
  business                Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId                 String
  store                   Store               @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  designId                String
  design                  Design              @relation(fields: [businessId, designId], references: [businessId, id], onDelete: NoAction)
  name                    String
  slug                    String
  description             String?
  imageFileId             String?
  image                   StoredFile?         @relation(fields: [businessId, imageFileId], references: [businessId, id], onDelete: NoAction)
  // The picture was made from the design's mockup (remade when the design changes).
  imageIsMockup           Boolean             @default(false)
  // The quote/order line it was published from, to update it on a later publish.
  sourceLineId            String?
  published               Boolean             @default(true)
  featured                Boolean             @default(false)
  sortOrder               Int                 @default(0)
  // Names and numbers shoppers can have printed, each with an optional charge.
  nameMode                PersonalizationMode @default(OFF)
  nameMaxLength           Int                 @default(12)
  namePrice               Decimal             @default(0) @db.Decimal(10, 2)
  numberMode              PersonalizationMode @default(OFF)
  numberMaxDigits         Int                 @default(2)
  numberPrice             Decimal             @default(0) @db.Decimal(10, 2)
  // Where they're printed ("Back"), for shoppers and the work order.
  personalizationLocation String?
  // Markup on top of the base price; empty = the store's default markup.
  markupKind              MarkupKind?
  markupValue             Decimal?            @db.Decimal(10, 2)
  prices                  StoreItemPrice[]
  cartItems               CartItem[]
  orderLines              OrderLine[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([businessId, id])
  @@unique([storeId, slug])
  @@index([storeId, sourceLineId])
}

model StoreItemPrice {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  itemId        String
  item          StoreItem   @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Cascade)
  sizeId        String
  size          ProductSize @relation(fields: [businessId, sizeId], references: [businessId, id], onDelete: NoAction)
  basePrice     Decimal     @db.Decimal(10, 2)
  overridePrice Decimal?    @db.Decimal(10, 2)

  @@unique([itemId, sizeId])
}

enum CartStatus {
  OPEN
  CHECKOUT // sent to the payment page
  COMPLETED // became an order
}

// A shopper's cart, found by the token in their cookie. Checkout details are
// kept on it until it becomes an order.
model Cart {
  id                String          @id @default(cuid())
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId           String
  store             Store           @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)
  tokenHash         String          @unique
  status            CartStatus      @default(OPEN)
  customerId        String?
  customer          Customer?       @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: NoAction)
  email             String?
  firstName         String?
  lastName          String?
  phone             String?
  shipName          String?
  shipLine1         String?
  shipLine2         String?
  shipCity          String?
  shipRegion        String?
  shipPostalCode    String?
  shipCountry       String          @default("US")
  deliveryMethodId  String?
  deliveryMethod    DeliveryMethod? @relation(fields: [businessId, deliveryMethodId], references: [businessId, id], onDelete: NoAction)
  promoCodeId       String?
  promoCode         PromoCode?      @relation(fields: [businessId, promoCodeId], references: [businessId, id], onDelete: NoAction)
  giftCodeId        String?
  giftCode          GiftCode?       @relation(fields: [businessId, giftCodeId], references: [businessId, id], onDelete: NoAction)
  note              String?
  amountDue         Decimal?        @db.Decimal(10, 2) // what was sent to the payment page
  checkoutSessionId String?         @unique
  orderId           String?
  order             Order?          @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: NoAction)
  items             CartItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([businessId, id])
}

model CartItem {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cartId      String
  cart        Cart      @relation(fields: [businessId, cartId], references: [businessId, id], onDelete: Cascade)
  storeItemId String
  storeItem   StoreItem @relation(fields: [businessId, storeItemId], references: [businessId, id], onDelete: Cascade)
  sizeId      String
  qty         Int
  // Personalization ("" = none); each name/number is its own cart line.
  name        String    @default("")
  number      String    @default("")

  @@unique([cartId, storeItemId, sizeId, name, number])
}

enum PromoKind {
  PERCENT
  AMOUNT
  FREE_SHIPPING
}

// Business-wide promo codes.
model PromoCode {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code        String // stored upper case
  description String?
  kind        PromoKind
  value       Decimal          @default(0) @db.Decimal(10, 2) // percent (10 = 10%) or amount
  minSubtotal Decimal?         @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int?
  usedCount   Int              @default(0)
  // Accepted in every store, or only the stores listed.
  allStores   Boolean          @default(true)
  stores      PromoCodeStore[]
  active      Boolean          @default(true)
  orders      Order[]
  carts       Cart[]
  createdAt   DateTime         @default(now())

  @@unique([businessId, id])
  @@unique([businessId, code])
}

// Business-wide gift codes with a balance, spent like a payment.
model GiftCode {
  id            String          @id @default(cuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code          String // stored upper case
  initialAmount Decimal         @db.Decimal(10, 2)
  balance       Decimal         @db.Decimal(10, 2)
  expiresAt     DateTime?
  active        Boolean         @default(true)
  allStores     Boolean         @default(true)
  stores        GiftCodeStore[]
  note          String? // who it was for
  uses          GiftCodeUse[]
  carts         Cart[]
  createdAt     DateTime        @default(now())

  @@unique([businessId, id])
  @@unique([businessId, code])
}

model GiftCodeUse {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  giftCodeId String
  giftCode   GiftCode @relation(fields: [businessId, giftCodeId], references: [businessId, id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
}

// ─── Shopper accounts ────────────────────────────────────────────────────

model CustomerSession {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([businessId, customerId])
}

// One-time sign-in links emailed to shoppers (sign up, magic link, reset).
model CustomerToken {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  customerId String?
  customer   Customer? @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId, email])
}

// Stores grouped for management (Schools, Teams, Fundraisers…). A group's
// settings apply to its stores unless a store sets its own.
model StoreGroup {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  sortOrder     Int          @default(0)
  accountMode   AccountMode?
  showPrices    Boolean?
  allowPayLater Boolean?
  markupKind    MarkupKind?
  markupValue   Decimal?     @db.Decimal(10, 2)
  stores        Store[]
  createdAt     DateTime     @default(now())

  @@unique([businessId, id])
  @@unique([businessId, name])
}

model PromoCodeStore {
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  promoCodeId String
  promoCode   PromoCode @relation(fields: [businessId, promoCodeId], references: [businessId, id], onDelete: Cascade)
  storeId     String
  store       Store     @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)

  @@id([promoCodeId, storeId])
}

model GiftCodeStore {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  giftCodeId String
  giftCode   GiftCode @relation(fields: [businessId, giftCodeId], references: [businessId, id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [businessId, storeId], references: [businessId, id], onDelete: Cascade)

  @@id([giftCodeId, storeId])
}

// ─── Supplier catalog imports ────────────────────────────────────────────

enum CatalogImportStatus {
  READY // file read; waiting for the user to choose what to import
  RUNNING
  DONE
  FAILED
}

// A supplier's product data file (e.g. SanMar's SDL download) being loaded
// into the catalog. The file stays in storage until the import is done.
model CatalogImport {
  id          String              @id @default(cuid())
  businessId  String
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier            @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: Cascade)
  format      String // "SANMAR_SDL"
  fileName    String
  storageKey  String
  status      CatalogImportStatus @default(READY)
  summary     Json // what the file holds: styles per brand, category and status
  options     Json? // what the user chose to import
  progress    Int                 @default(0) // styles done
  total       Int                 @default(0)
  result      Json? // added / updated counts
  error       String?
  createdById String?
  createdBy   StaffUser?          @relation(fields: [businessId, createdById], references: [businessId, id], onDelete: NoAction)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt // also shows an import is still moving
  finishedAt  DateTime?

  @@unique([businessId, id])
}
